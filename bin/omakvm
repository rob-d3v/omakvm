#!/usr/bin/env bash
# omakvm helper: the steps the panel cannot do from inside the shell.
#
#   omakvm install [--from <tarball>]   install Mickey on this PC (asks for sudo once)
#   omakvm add-ssh [options] user@host  install Mickey on a PC you reach by SSH and
#                                       pair it with this one, without the six-digit code
#   omakvm espanso on|off|status        let espanso's triggers work while the keyboard is
#                                       on another PC (and find keyboards plugged in later)
#   omakvm doctor                       say what is installed, running and paired
#   omakvm root-setup <user>            (as root) only the part of install that needs root
#
# add-ssh options: --name <name>  --address <ip>  -i <ssh key>  -p <ssh port>
#                  --from <tarball>  --kiosk | --session
#
# Mickey (https://github.com/EduardoMG12/mickey, GPL-3.0-or-later) is the program
# that carries the keyboard, mouse and clipboard between PCs. This script downloads
# its official release, checks it against Mickey's release key, and installs it the
# way Mickey's own install.sh does.
set -euo pipefail

MICKEY_REPO="https://github.com/EduardoMG12/mickey"
# Mickey publishes x86-64 only. This plugin's releases carry the rest:
#   mickey-linux-aarch64         Mickey's source, unchanged (packaging/build-aarch64.sh)
#   mickey-fork-linux-armv7      for 32-bit ARM, which Mickey's own source cannot serve
#   mickey-fork-linux-x86_64     for `omakvm espanso on`
# The fork is https://github.com/rob-d3v/mickey, branch omakvm: Mickey plus 32-bit
# Linux, devices plugged in later, and the typing mirror (packaging/build-fork.sh).
ARM_RELEASES="${OMAKVM_ARM_RELEASES:-https://github.com/rob-d3v/omakvm/releases/latest/download}"
# The Ed25519 key that signs Mickey's releases (packaging/release-key.pub there).
MICKEY_KEY="d5cbc9a4c2b7b0b7c173827cd7be585adaa046cdf3c269b73c9f82600aa05602"
PORT=4242
# The oldest glibc each build runs on.
GLIBC_X86_64="2.35"
GLIBC_AARCH64="2.36"
GLIBC_ARMV7="2.28"
MIRROR_NAME="Mickey typing mirror"

export PATH="$HOME/.local/bin:$PATH"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/omakvm"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mickey"
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/mickey"

say() { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }
die() { printf '\nomakvm: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "this needs \`$1\`, which is not installed"; }

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }

# ------------------------------------------------------------------ download

# Mickey's signature is over SHA256SUMS; the sums then cover the tarball.
verify_signature() {
  local sums="$1" pem
  need openssl
  pem="$(mktemp)"
  {
    echo "-----BEGIN PUBLIC KEY-----"
    printf '%b' "$(echo "302a300506032b6570032100$MICKEY_KEY" | sed 's/../\\x&/g')" | base64
    echo "-----END PUBLIC KEY-----"
  } >"$pem"
  if ! openssl pkeyutl -verify -pubin -inkey "$pem" -rawin -in "$sums" -sigfile "$sums.sig" >/dev/null 2>&1; then
    rm -f "$pem"
    die "SHA256SUMS is not signed by Mickey's release key: nothing installed"
  fi
  rm -f "$pem"
}

# Prints the folder of an unpacked, checked release for <arch>.
fetch_release() {
  local arch="$1" from="${2:-}" dir tarball
  need tar
  dir="$cache/release-$arch"
  rm -rf "$dir"
  mkdir -p "$dir"
  tarball="$dir/mickey-linux-$arch.tar.gz"
  if [[ -n $from ]]; then
    [[ -f $from ]] || die "$from is not a file"
    cp "$from" "$tarball"
    say "Using $from (not checked against a signature: you supplied it)" >&2
  elif [[ $arch == x86_64 ]]; then
    need curl
    say "Downloading Mickey's latest release from $MICKEY_REPO" >&2
    curl -fsSL --proto '=https' -o "$tarball" "$MICKEY_REPO/releases/latest/download/mickey-linux-x86_64.tar.gz"
    curl -fsSL --proto '=https' -o "$dir/SHA256SUMS" "$MICKEY_REPO/releases/latest/download/SHA256SUMS"
    curl -fsSL --proto '=https' -o "$dir/SHA256SUMS.sig" "$MICKEY_REPO/releases/latest/download/SHA256SUMS.sig"
    verify_signature "$dir/SHA256SUMS"
    (cd "$dir" && sha256sum -c --ignore-missing --status SHA256SUMS) \
      || die "the download does not match Mickey's SHA256SUMS: nothing installed"
    say "Signed by Mickey's release key, and unchanged" >&2
  elif [[ $arch == aarch64 || $arch == armv7 || $arch == fork-x86_64 ]]; then
    need curl
    local asset
    case "$arch" in
      aarch64) asset=mickey-linux-aarch64.tar.gz
        say "Mickey publishes no ARM64 build; downloading the one built for omakvm from its source" >&2 ;;
      armv7) asset=mickey-fork-linux-armv7.tar.gz
        say "Mickey's own source does not work on 32-bit ARM; downloading omakvm's fork of it" >&2 ;;
      *) asset=mickey-fork-linux-x86_64.tar.gz
        say "Downloading omakvm's fork of Mickey (typing mirror, devices plugged in later)" >&2 ;;
    esac
    tarball="$dir/$asset"
    curl -fsSL --proto '=https' -o "$tarball" "$ARM_RELEASES/$asset" \
      || die "could not download $asset. Build it with packaging/ and pass it with --from"
    curl -fsSL --proto '=https' -o "$dir/SHA256SUMS" "$ARM_RELEASES/SHA256SUMS"
    (cd "$dir" && sha256sum -c --ignore-missing --status SHA256SUMS) \
      || die "the download does not match its SHA256SUMS: nothing installed"
  else
    die "no Mickey build for $arch"
  fi
  tar -xzf "$tarball" -C "$dir"
  local inner
  inner="$(find "$dir" -maxdepth 2 -type f -name mickey -perm -u+x | head -n 1)"
  [[ -n $inner ]] || die "the release holds no mickey program"
  dirname "$inner"
}

# ------------------------------------------------------------------- install

# What needs root, for <user>: let the input group create Mickey's virtual
# keyboard and read the real one, open the firewall for the other PCs, and
# make both work now rather than after the next restart.
root_setup() {
  local user="${1:-}"
  [[ $(id -u) -eq 0 ]] || die "root-setup must run as root"
  id "$user" >/dev/null 2>&1 || die "no such user: $user"
  printf '%s\n' '# Lets the input group create Mickey'"'"'s virtual keyboard and mouse.' \
    'KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"' \
    >/etc/udev/rules.d/99-mickey-uinput.rules
  udevadm control --reload || true
  modprobe uinput 2>/dev/null || true
  chgrp input /dev/uinput && chmod 660 /dev/uinput
  if ! id -nG "$user" | grep -qw input; then
    usermod -aG input "$user"
    echo "Added $user to the input group (in full effect after the next restart)"
  fi
  # The running session still has the old groups: grant this user the devices
  # that exist now, so Mickey works before that restart.
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "u:$user:rw" /dev/uinput /dev/input/event* 2>/dev/null || true
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    echo "Letting other PCs reach Mickey through ufw (TCP 4242-4243, UDP 4243-4244)"
    for port in 4242/tcp 4243/tcp 4243/udp 4244/udp; do ufw allow "$port" comment Mickey >/dev/null; done
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    echo "Letting other PCs reach Mickey through firewalld (TCP 4242-4243, UDP 4243-4244)"
    for port in 4242/tcp 4243/tcp 4243/udp 4244/udp; do
      firewall-cmd -q --permanent --add-port="$port"; firewall-cmd -q --add-port="$port"
    done
  fi
}

install_here() {
  local from="" root=1 dir
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 ;;
      --no-root) root=0; shift ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  step "Getting Mickey"
  dir="$(fetch_release "$(uname -m)" "$from")"
  "$dir/mickey" --version >/dev/null 2>&1 \
    || die "Mickey cannot start here; it needs PulseAudio's client library (Arch: sudo pacman -S libpulse; Debian/Ubuntu: sudo apt install libpulse0)"
  if [[ $root -eq 1 ]]; then
    step "Letting Mickey use the keyboard and mouse (sudo asks for your password once)"
    say "  Every program you run as a member of the input group can read your"
    say "  keyboard, not only Mickey. Install Mickey only on your own PCs."
    sudo "$(readlink -f "$0")" root-setup "$USER"
  fi
  step "Installing Mickey for $USER"
  # --update: Mickey's installer without its sudo steps, done above.
  (cd "$dir" && sh ./install.sh --update)
  if [[ ! -f $config_dir/config.toml ]]; then
    mkdir -p "$config_dir"
    printf '[this_pc]\nname = "%s"\n' "$(hostname | tr -d '"\\')" >"$config_dir/config.toml"
  fi
  systemctl --user restart mickey.service 2>/dev/null || true
  step "Done"
  "$dir/mickey" --version
  say "Open the panel (the two-screens icon in the bar) and press Add PC."
}

# -------------------------------------------------------------------- doctor

doctor() {
  if ! command -v mickey >/dev/null 2>&1; then
    say "mickey: not installed (omakvm install)"; return 1
  fi
  say "mickey: $(mickey --version 2>&1 | head -n 1)"
  say "service: $(systemctl --user is-active mickey.service 2>/dev/null || true)"
  if id -nG | grep -qw input; then say "input group: yes"
  else say "input group: not in this session (restart this PC once after installing)"; fi
  [[ -w /dev/uinput ]] && say "/dev/uinput: writable" || say "/dev/uinput: NOT writable"
  say "fingerprint: $(mickey id 2>/dev/null | tail -n 1)"
  say
  mickey status 2>&1 || true
  say
  mickey peers 2>&1 | tr '\t' ' ' || true
}

# ------------------------------------------------------------------- espanso

# espanso reads the keyboards itself. While the keyboard is on another PC,
# Mickey holds them, so espanso hears nothing and its triggers stop. The fork
# repeats what you type for the other PC on a virtual keyboard ("typing
# mirror") that only espanso reads; what espanso then types leaves through its
# own virtual keyboard, which Mickey sends to the other PC like any key.
espanso_dropin="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/mickey.service.d/omakvm-espanso.conf"
espanso_config="${XDG_CONFIG_HOME:-$HOME/.config}/espanso/config/default.yml"
espanso_rule="/etc/udev/rules.d/99-mickey-typing-mirror.rules"

# As root: the desktop must not read the mirror, or the keys would also be
# typed on this PC.
root_espanso() {
  [[ $(id -u) -eq 0 ]] || die "root-espanso must run as root"
  printf '%s\n' "# omakvm: the desktop (libinput) ignores Mickey's typing mirror; only text expanders read it." \
    "SUBSYSTEM==\"input\", ATTRS{name}==\"$MIRROR_NAME\", ENV{LIBINPUT_IGNORE_DEVICE}=\"1\"" >"$espanso_rule"
  udevadm control --reload
}

mirror_node() {
  local f
  for f in /sys/class/input/event*/device/name; do
    [[ -f $f && $(cat "$f") == "$MIRROR_NAME" ]] && { echo "/dev/input/$(basename "$(dirname "$(dirname "$f")")")"; return 0; }
  done
  return 1
}

espanso_status() {
  local node
  [[ -f $HOME/.local/bin/.mickey-omakvm-fork ]] && say "Mickey: omakvm's fork ($(cat "$HOME/.local/bin/.mickey-omakvm-fork"))" || say "Mickey: the official build (no typing mirror)"
  [[ -f $espanso_dropin ]] && say "typing mirror: asked for" || say "typing mirror: off"
  [[ -f $espanso_rule ]] && say "udev rule: installed" || say "udev rule: MISSING (the keys would also be typed on this PC)"
  if node="$(mirror_node)"; then
    if udevadm info -q property -n "$node" 2>/dev/null | grep -q '^LIBINPUT_IGNORE_DEVICE=1'; then
      say "mirror keyboard: $node, ignored by the desktop"
    else
      say "mirror keyboard: $node, NOT ignored by the desktop"
    fi
  else
    say "mirror keyboard: none (Mickey is not running with it)"
  fi
  say "espanso: $(systemctl --user is-active espanso.service 2>/dev/null || true)"
  grep -qs '^backend: *Inject' "$espanso_config" && say "espanso types its text key by key (backend: Inject)" \
    || say "espanso may paste long text from this PC's clipboard, which the other PC does not have"
}

espanso_on() {
  local from="" dir here
  [[ ${1:-} == --from ]] && from="${2:-}"
  [[ $(uname -m) == x86_64 ]] || die "the fork is built for x86-64 only for now"
  command -v espanso >/dev/null 2>&1 || die "espanso is not installed on this PC"
  here="$(command -v mickey || true)"
  [[ $here == "$HOME/.local/bin/mickey" ]] \
    || die "this replaces Mickey in ~/.local/bin; yours is ${here:-not installed}. Install it with: omakvm install"

  step "Getting the fork of Mickey"
  dir="$(fetch_release fork-x86_64 "$from")"
  "$dir/mickey" --version >/dev/null 2>&1 || die "the fork does not start on this PC"

  step "Keeping the desktop from reading the mirror (sudo asks for your password once)"
  if [[ -f $espanso_rule ]]; then say "The udev rule is already there"
  else sudo "$(readlink -f "$0")" root-espanso; fi

  step "Installing"
  [[ -f $HOME/.local/bin/.mickey-omakvm-fork ]] || {
    cp -p "$HOME/.local/bin/mickey" "$HOME/.local/bin/mickey.official"
    [[ -f $HOME/.local/bin/mickey-ui ]] && cp -p "$HOME/.local/bin/mickey-ui" "$HOME/.local/bin/mickey-ui.official"
  }
  install -m 755 "$dir/mickey" "$HOME/.local/bin/mickey.new" && mv "$HOME/.local/bin/mickey.new" "$HOME/.local/bin/mickey"
  install -m 755 "$dir/mickey-ui" "$HOME/.local/bin/mickey-ui.new" && mv "$HOME/.local/bin/mickey-ui.new" "$HOME/.local/bin/mickey-ui"
  cat "$dir/SOURCE-COMMIT" >"$HOME/.local/bin/.mickey-omakvm-fork"
  mkdir -p "$(dirname "$espanso_dropin")"
  printf '%s\n' '# omakvm espanso on' '[Service]' 'Environment=MICKEY_TYPING_MIRROR=1' >"$espanso_dropin"
  # Mickey's updater would put the official build back.
  mkdir -p "$config_dir"; touch "$config_dir/config.toml"
  if grep -q '^\[updates\]' "$config_dir/config.toml"; then
    sed -i '/^\[updates\]/,/^\[/ s/^check *=.*/check = false/' "$config_dir/config.toml"
    grep -A3 '^\[updates\]' "$config_dir/config.toml" | grep -q '^check = false' \
      || sed -i '/^\[updates\]/a check = false' "$config_dir/config.toml"
  else
    printf '\n[updates]\ncheck = false\n' >>"$config_dir/config.toml"
  fi
  # Long text would otherwise be pasted from this PC's clipboard with Ctrl+V,
  # and the other PC has another clipboard: type it key by key instead.
  if [[ -f $espanso_config ]] && ! grep -q '^backend:' "$espanso_config"; then
    cp -p "$espanso_config" "$espanso_config.bak.$(date +%Y%m%d%H%M%S)"
    printf '%s\n' '# omakvm espanso on: type every expansion key by key, so it also reaches another PC' 'backend: Inject' >>"$espanso_config"
  fi

  step "Restarting Mickey and espanso"
  systemctl --user daemon-reload
  systemctl --user restart mickey.service
  sleep 2
  systemctl --user restart espanso.service 2>/dev/null || espanso restart >/dev/null 2>&1 || true
  sleep 3
  espanso_status
  say
  say "Try it: take the keyboard to another PC and type one of your triggers there."
  say "Both PCs need the same keyboard layout: the text is typed as keys."
}

espanso_off() {
  if [[ -f $HOME/.local/bin/mickey.official ]]; then
    mv "$HOME/.local/bin/mickey.official" "$HOME/.local/bin/mickey"
    [[ -f $HOME/.local/bin/mickey-ui.official ]] && mv "$HOME/.local/bin/mickey-ui.official" "$HOME/.local/bin/mickey-ui"
  fi
  rm -f "$HOME/.local/bin/.mickey-omakvm-fork" "$espanso_dropin"
  rmdir "$(dirname "$espanso_dropin")" 2>/dev/null || true
  [[ -f $espanso_config ]] && sed -i '/^# omakvm espanso on:/d; /^backend: Inject$/d' "$espanso_config"
  [[ -f $config_dir/config.toml ]] && sed -i '/^\[updates\]/,/^\[/ s/^check = false$/check = true/' "$config_dir/config.toml"
  systemctl --user daemon-reload
  systemctl --user restart mickey.service 2>/dev/null || true
  systemctl --user restart espanso.service 2>/dev/null || true
  say "Back to the official Mickey, without the typing mirror."
  [[ -f $espanso_rule ]] && say "The udev rule stays (it does nothing without the mirror); to remove it: sudo rm $espanso_rule"
}

# ------------------------------------------------------------------- add-ssh

toml_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# The lines "<first> <last>" of the [[peer]] table whose address is $2, in $1.
peer_range() {
  awk -v a="address = \"$2\"" '
    /^[ \t]*\[/ {
      if (hit && !e) e = NR - 1
      if (!hit) s = ($0 ~ /^[ \t]*\[\[peer\]\]/) ? NR : 0
    }
    s && index($0, a) { hit = 1 }
    END { if (hit) print s, (e ? e : NR) }' "$1"
}

# One field ("name" or "key") of the lines $2..$3 of $1, unquoted.
peer_field() {
  sed -n "$2,$3p" "$1" | sed -n "s/^[ \t]*$4[ \t]*=[ \t]*\"\(.*\)\"[ \t]*\$/\1/p" | head -n 1
}

# Mickey as a service of the user's own session.
session_unit() {
  printf '%s\n' \
    '[Unit]' \
    'Description=Mickey: one keyboard and mouse for all your computers (set up by omakvm)' \
    '# session: PartOf=graphical-session.target' \
    '# session: After=graphical-session.target' \
    '' \
    '[Service]' \
    'ExecStart=%h/.local/bin/mickey run' \
    'Restart=on-failure' \
    'RestartSec=3' \
    '' \
    '[Install]' \
    'WantedBy=default.target'
}

# Mickey on a kiosk: a system service that still runs as <user>, in the input
# group, with a copy of the X server's access cookie only <user> can read.
# The copy is made as root right before Mickey starts: the cookie file the X
# server was started with, or an empty one when it was started without. With
# no X server yet that step fails and systemd tries again 3 s later.
kiosk_unit() {
  local user="$1" display="$2" home="$3"
  printf '%s\n' \
    '[Unit]' \
    'Description=Mickey: one keyboard and mouse for all your computers (set up by omakvm)' \
    'After=network.target' \
    '' \
    '[Service]' \
    "User=$user" \
    'SupplementaryGroups=input' \
    'RuntimeDirectory=mickey' \
    "Environment=DISPLAY=$display XAUTHORITY=/run/mickey/xauth" \
    "ExecStartPre=+/bin/sh -c 'pgrep -x Xorg >/dev/null || pgrep -x X >/dev/null || exit 1; a=\$\$(ps -C Xorg,X -o args= | sed -n \"s/.* -auth \\\\([^ ]*\\\\).*/\\\\1/p\" | head -n 1); if [ -n \"\$\$a\" ] && [ -f \"\$\$a\" ]; then install -m 600 -o $user \"\$\$a\" /run/mickey/xauth; else install -m 600 -o $user /dev/null /run/mickey/xauth; fi'" \
    "ExecStart=$home/.local/bin/mickey run" \
    'Restart=always' \
    'RestartSec=3' \
    '' \
    '[Install]' \
    'WantedBy=multi-user.target'
}

# What runs as root on the other PC: sh <this> <user> <kiosk|session> <unit file>.
remote_root_script() {
  cat <<'ROOT'
set -e
u="$1"; mode="$2"; unit="$3"
if ! ldconfig -p 2>/dev/null | grep -q 'libpulse\.so\.0'; then
  echo "Mickey needs PulseAudio's client library: installing libpulse0"
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q libpulse0 >/dev/null || {
      echo "could not install libpulse0 (no internet there?): install it and run add-ssh again" >&2; exit 1; }
  else
    echo "install PulseAudio's client library there (libpulse) and run add-ssh again" >&2; exit 1
  fi
fi
printf '%s\n' 'KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"' > /etc/udev/rules.d/99-mickey-uinput.rules
udevadm control --reload 2>/dev/null || true
modprobe uinput 2>/dev/null || true
getent group input >/dev/null || groupadd -r input
chgrp input /dev/uinput && chmod 660 /dev/uinput
id -nG "$u" | grep -qw input || usermod -aG input "$u"
if command -v setfacl >/dev/null 2>&1; then setfacl -m "u:$u:rw" /dev/uinput; fi
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
  for p in 4242/tcp 4243/tcp 4243/udp 4244/udp; do ufw allow "$p" comment Mickey >/dev/null; done
fi
if [ "$mode" = kiosk ]; then
  install -m 644 "$unit" /etc/systemd/system/mickey.service
  systemctl daemon-reload
  systemctl enable -q mickey.service
  systemctl restart mickey.service
else
  # Without a login, the user's services only run if they may linger.
  loginctl enable-linger "$u" 2>/dev/null || true
  # A session that never got the input group still has to reach the device.
  command -v setfacl >/dev/null 2>&1 || chmod 666 /dev/uinput
fi
ROOT
}

add_ssh() {
  local name="" address="" from="" identity="" sshport="" target="" mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --address) address="${2:-}"; shift 2 ;;
      --from) from="${2:-}"; shift 2 ;;
      -i) identity="${2:-}"; shift 2 ;;
      -p) sshport="${2:-}"; shift 2 ;;
      --kiosk) mode=kiosk; shift ;;
      --session) mode=session; shift ;;
      -*) die "add-ssh: unknown option $1" ;;
      *) target="$1"; shift ;;
    esac
  done
  [[ $target =~ ^([A-Za-z0-9_][A-Za-z0-9_.-]*@)?[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
    || die "usage: omakvm add-ssh [--name <name>] [--address <ip>] [-i <key>] [-p <port>] [--from <tarball>] [--kiosk|--session] user@host"
  [[ -z $sshport || $sshport =~ ^[0-9]+$ ]] || die "-p takes a port number"
  command -v mickey >/dev/null 2>&1 || die "install Mickey on this PC first: omakvm install"
  need ssh; need scp; need awk

  # --- one SSH connection for everything, so a password is typed once
  local ctl probe=() ssh_opts=() scp_opts=()
  ctl="$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/omakvm-ssh.XXXXXX")"
  # accept-new: a PC seen for the first time has its host key remembered; one
  # whose key changed is still refused.
  probe=(-o ControlMaster=auto -o "ControlPath=$ctl" -o ControlPersist=300 -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10)
  [[ -n $sshport ]] && probe+=(-p "$sshport")
  # shellcheck disable=SC2064
  trap "ssh -o ControlPath='$ctl' -O exit '$target' >/dev/null 2>&1 || true" EXIT

  # One attempt only: a server that sees key after key fail starts refusing
  # the connection (OpenSSH's per-source penalties), so the keys are never
  # tried in a loop. The key that worked for a PC is remembered for next time.
  step "Connecting to $target"
  local connected=0 remembered="$cache/ssh-keys"
  if [[ -z $identity && -f $remembered ]]; then
    identity="$(awk -v t="$target" '$1 == t { print $2 }' "$remembered" | tail -n 1)"
    [[ -n $identity && -f $identity ]] || identity=""
  fi
  if [[ -n $identity ]]; then
    [[ -f $identity ]] || die "$identity is not a file"
    say "With the SSH key ${identity/#$HOME/\~}"
    ssh "${probe[@]}" -o IdentitiesOnly=yes -i "$identity" "$target" true && connected=1
  else
    say "With your default SSH keys; without one that fits, ssh asks for that user's password."
    ssh "${probe[@]}" "$target" true && connected=1
  fi
  [[ $connected -eq 1 ]] || die "cannot reach $target over SSH (to use a specific key: -i <key>). Nothing was changed."
  if [[ -n $identity ]]; then
    mkdir -p "$cache"
    { [[ -f $remembered ]] && awk -v t="$target" '$1 != t' "$remembered"; printf '%s %s\n' "$target" "$identity"; } >"$remembered.new"
    mv "$remembered.new" "$remembered"
  fi
  ssh_opts=(-o "ControlPath=$ctl")
  scp_opts=(-o "ControlPath=$ctl")
  [[ -n $sshport ]] && { ssh_opts+=(-p "$sshport"); scp_opts+=(-P "$sshport"); }
  remote() { ssh "${ssh_opts[@]}" "$target" "$@"; }

  # --- what is there
  step "Looking at $target"
  local facts
  # shellcheck disable=SC2016
  facts="$(remote 'echo "m:$(uname -m)"; echo "h:$(hostname)"; echo "i:$(hostname -I 2>/dev/null | cut -d" " -f1)"
echo "u:$(id -un)"; echo "o:$HOME"; echo "b:$(getconf LONG_BIT 2>/dev/null)"
echo "g:$(ldd --version 2>/dev/null | head -n 1 | grep -o "[0-9]\+\.[0-9]\+$")"
echo "x:$(ps -C Xorg,X -o user= 2>/dev/null | head -n 1 | tr -d " ")"
echo "d:$(ps -C Xorg,X -o args= 2>/dev/null | grep -o " :[0-9]\+" | head -n 1 | tr -d " ")"
echo "w:$(ls /run/user/*/wayland-[0-9] 2>/dev/null | head -n 1)"
echo "s:$(command -v systemctl >/dev/null 2>&1 && echo yes)"')" || die "cannot run commands on $target"
  fact() { sed -n "s/^$1://p" <<<"$facts" | head -n 1; }
  local machine host ip ruser rhome bits glibc xowner display wayland arch need_glibc
  machine="$(fact m)"; host="$(fact h)"; ip="$(fact i)"; ruser="$(fact u)"; rhome="$(fact o)"
  bits="$(fact b)"; glibc="$(fact g)"; xowner="$(fact x)"; display="$(fact d)"; wayland="$(fact w)"
  [[ $ruser =~ ^[a-z_][a-z0-9_-]*$ ]] || die "unexpected user name on $target"
  [[ $rhome =~ ^/[A-Za-z0-9_./-]+$ ]] || die "unexpected home folder on $target"
  [[ $(fact s) == yes ]] || die "$target has no systemd; Mickey's service needs it. Nothing was changed."
  [[ $display =~ ^:[0-9]+$ ]] || display=":0"

  # What counts is the system's programs, not the kernel: a Raspberry Pi
  # often runs a 32-bit system under a 64-bit kernel.
  case "$machine" in
    x86_64)
      [[ $bits != 32 ]] || die "$target runs a 32-bit x86 system; there is no Mickey build for it. Nothing was changed."
      arch=x86_64; need_glibc=$GLIBC_X86_64 ;;
    aarch64|arm64|armv8l)
      if [[ $bits == 32 ]]; then arch=armv7; need_glibc=$GLIBC_ARMV7
      else arch=aarch64; need_glibc=$GLIBC_AARCH64; fi ;;
    armv7l) arch=armv7; need_glibc=$GLIBC_ARMV7 ;;
    armv6l) die "$target is an ARMv6 board (Raspberry Pi 1 or Zero); the 32-bit build needs ARMv7 or newer. Nothing was changed." ;;
    *) die "$target is a $machine machine; there is no Mickey build for it. Nothing was changed." ;;
  esac
  if [[ -n $glibc && $(printf '%s\n%s\n' "$glibc" "$need_glibc" | sort -V | head -n 1) != "$need_glibc" ]]; then
    die "$target has glibc $glibc; this Mickey build needs $need_glibc or newer (a newer system image). Nothing was changed."
  fi

  if [[ -z $address ]]; then
    address="${target#*@}"
    [[ $address =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || address="$ip"
  fi
  [[ $address =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "cannot tell $target's IP address; pass --address"

  # A kiosk: the screen is an X server that no login session of the SSH user
  # owns, so a service of that user would see neither its monitors nor its
  # clipboard, and the cursor could not cross at an edge.
  if [[ -z $mode ]]; then
    if [[ -n $xowner ]]; then mode=kiosk; else mode=session; fi
  fi

  # The name: what was asked, else the one this PC already uses for that
  # address, else the host name; made unique, since boards flashed from one
  # image share a host name.
  mkdir -p "$data_dir" "$config_dir"
  touch "$config_dir/config.toml" "$data_dir/trusted_peers"
  chmod 600 "$data_dir/trusted_peers"
  local range known="" oldkey=""
  range="$(peer_range "$config_dir/config.toml" "$address:$PORT")"
  if [[ -n $range ]]; then
    known="$(peer_field "$config_dir/config.toml" "${range% *}" "${range#* }" name)"
    oldkey="$(peer_field "$config_dir/config.toml" "${range% *}" "${range#* }" key)"
  fi
  if [[ -n $known ]]; then
    name="$known"
  else
    [[ -n $name ]] || name="$host"
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]{0,50}$ ]] || name="PC"
    if grep -qF "name = \"$name\"" "$config_dir/config.toml"; then
      name="$name ${address#*.*.}"
    fi
  fi

  say "$name: $machine, glibc ${glibc:-?}, at $address"
  if [[ $mode == kiosk ]]; then
    say "Kiosk: the screen is ${xowner:-an} X server $display; Mickey runs as a system service of $ruser."
  elif [[ -n $wayland ]]; then
    say "Wayland session there: Mickey can type and click, but learns the monitors only"
    say "where the desktop offers the RemoteDesktop portal. Without them, use the hotkeys."
  else
    say "No screen session found: Mickey runs as a service of $ruser (keyboard only makes sense once a screen is up)."
  fi

  step "Getting Mickey for $arch"
  local dir
  dir="$(fetch_release "$arch" "$from")"

  # --- everything that needs no root
  step "Installing Mickey on $name"
  remote 'mkdir -p ~/.local/bin ~/.config/mickey ~/.local/share/mickey ~/.config/systemd/user'
  scp -q "${scp_opts[@]}" "$dir/mickey" "$target:.local/bin/mickey.new"
  [[ -f $dir/mickey-ui ]] && scp -q "${scp_opts[@]}" "$dir/mickey-ui" "$target:.local/bin/mickey-ui.new"
  remote 'cd ~/.local/bin && chmod 755 mickey.new && mv mickey.new mickey && { [ ! -f mickey-ui.new ] || { chmod 755 mickey-ui.new && mv mickey-ui.new mickey-ui; }; }'
  # That PC only receives: it never sends its own keyboard anywhere.
  # shellcheck disable=SC2016
  # Nor does it look for updates: Mickey's updater only knows its x86-64
  # release, and this script is what updates that PC.
  remote 'c=~/.config/mickey/config.toml; [ -f "$c" ] || printf "[this_pc]\nname = \"%s\"\ncontrols_others = false\ncontrolled = true\n\n[updates]\ncheck = false\n" "'"$(toml_escape "$name")"'" > "$c"'
  if [[ $mode == kiosk ]]; then
    kiosk_unit "$ruser" "$display" "$rhome" | remote 'cat > ~/.config/mickey/mickey.service.omakvm'
    # shellcheck disable=SC2016
    remote 'export XDG_RUNTIME_DIR="/run/user/$(id -u)"; systemctl --user disable -q --now mickey.service 2>/dev/null; rm -f ~/.config/systemd/user/mickey.service; true'
  else
    session_unit | remote 'cat > ~/.config/systemd/user/mickey.service'
  fi
  remote_root_script | remote 'cat > ~/.config/mickey/omakvm-root.sh'

  # --- the one step that needs root there
  step "The part that needs root on $name (its sudo may ask for $ruser's password)"
  local tty=()
  [[ -t 0 ]] && tty=(-t)
  ssh "${tty[@]}" "${ssh_opts[@]}" "$target" "sudo sh $rhome/.config/mickey/omakvm-root.sh $ruser $mode $rhome/.config/mickey/mickey.service.omakvm" \
    || die "the root step failed on $name. Mickey's files are in $rhome/.local/bin and $rhome/.config/mickey there; no service was changed. Run it again from a terminal to type the password."
  remote 'rm -f ~/.config/mickey/omakvm-root.sh ~/.config/mickey/mickey.service.omakvm'

  if [[ $mode == session ]]; then
    # A desktop has graphical-session.target, and there the service needs the
    # session's environment; a board has not.
    # shellcheck disable=SC2016
    remote 'export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if systemctl --user -q is-active graphical-session.target 2>/dev/null; then
  sed -i "s|^# session: ||; s|^WantedBy=.*|WantedBy=graphical-session.target|" ~/.config/systemd/user/mickey.service
else
  sed -i "/^# session: /d" ~/.config/systemd/user/mickey.service
fi
systemctl --user daemon-reload && systemctl --user enable -q mickey.service && systemctl --user restart mickey.service' \
      || die "could not start Mickey's service on $name: ssh $target journalctl --user -u mickey -n 30"
  fi

  # --- pairing: each side learns the other's public key over this SSH link
  step "Pairing over SSH"
  local mine theirs me tries=0
  mine="$(mickey id --key | tr -d '[:space:]')"
  [[ $mine =~ ^[0-9a-f]{64}$ ]] || die "cannot read this PC's Mickey key"
  sleep 2
  theirs=""
  while [[ ! $theirs =~ ^[0-9a-f]{64}$ && $tries -lt 5 ]]; do
    theirs="$(remote '~/.local/bin/mickey id --key 2>/dev/null' | tr -d '[:space:]' || true)"
    tries=$((tries + 1))
    [[ $theirs =~ ^[0-9a-f]{64}$ ]] || sleep 2
  done
  [[ $theirs =~ ^[0-9a-f]{64}$ ]] || die "Mickey does not run on $name: ssh $target '~/.local/bin/mickey --version'"
  me="$(hostname)"
  # shellcheck disable=SC2016
  remote 'f=~/.local/share/mickey/trusted_peers; touch "$f"; chmod 600 "$f"; grep -q "^'"$mine"'" "$f" || echo "'"$mine"' omakvm:'"${me//[^A-Za-z0-9._-]/_}"'" >> "$f"'
  grep -q "^$theirs" "$data_dir/trusted_peers" || echo "$theirs omakvm:$address" >>"$data_dir/trusted_peers"
  cp -p "$config_dir/config.toml" "$config_dir/config.toml.bak.$(date +%Y%m%d%H%M%S)"
  if [[ -n $range ]]; then
    if [[ $oldkey != "$theirs" ]]; then
      # Flashed again since it was paired: same address, new identity.
      say "$name has a new identity (it was reinstalled): updating its key here"
      awk -v s="${range% *}" -v e="${range#* }" -v a="address = \"$address:$PORT\"" -v k="key = \"$theirs\"" '
        NR >= s && NR <= e && /^[ \t]*key[ \t]*=/ { next }
        { print }
        NR >= s && NR <= e && index($0, a) { print k }' "$config_dir/config.toml" >"$config_dir/config.toml.new"
      mv "$config_dir/config.toml.new" "$config_dir/config.toml"
      if [[ $oldkey =~ ^[0-9a-f]{64}$ ]]; then
        grep -v "^$oldkey" "$data_dir/trusted_peers" >"$data_dir/trusted_peers.new" || true
        chmod 600 "$data_dir/trusted_peers.new"
        mv "$data_dir/trusted_peers.new" "$data_dir/trusted_peers"
      fi
    else
      say "$name is already one of this PC's peers, with this key"
    fi
  else
    # Tables of peers go before the first plain [section], where Mickey writes them too.
    {
      printf '[[peer]]\nname = "%s"\naddress = "%s:%s"\nkey = "%s"\n\n' "$(toml_escape "$name")" "$address" "$PORT" "$theirs"
      cat "$config_dir/config.toml"
    } >"$config_dir/config.toml.new"
    mv "$config_dir/config.toml.new" "$config_dir/config.toml"
  fi

  step "Checking the link"
  systemctl --user restart mickey.service 2>/dev/null || { mickey quit >/dev/null 2>&1 || true; mickey start; }
  local line="" waited=0
  while [[ $waited -lt 15 ]]; do
    sleep 1; waited=$((waited + 1))
    line="$(mickey peers 2>/dev/null | awk -F'\t' -v n="$name" '$1 == "peer" && $4 == n { print $2 "\t" $5 }')"
    [[ ${line%%$'\t'*} == online ]] && break
  done
  if [[ ${line%%$'\t'*} != online ]]; then
    say "$name is installed and paired, but did not come online in 15 s."
    if [[ $mode == kiosk ]]; then say "Look at its log:  ssh $target sudo journalctl -u mickey -n 30"
    else say "Look at its log:  ssh $target journalctl --user -u mickey -n 30"; fi
    say "A firewall between the two networks must let TCP 4242-4243 through."
    exit 1
  fi
  step "Done"
  local monitors="${line#*$'\t'}"
  if [[ -n $monitors ]]; then
    say "$name is online, screen ${monitors//;/ + }."
    say "Open the panel: it is placed to the right of your screens; drag it where it"
    say "really sits and press Save. Then push the cursor across that edge."
  else
    say "$name is online, but it reported no screen, so the cursor cannot cross at an"
    say "edge. Reach it with:  mickey go \"$name\"   (or AltGr + Right Shift)"
  fi
  say "Bring the keyboard home at any time by holding Right Shift for 3 seconds."
}

case "${1:-}" in
  install) shift; install_here "$@" ;;
  add-ssh) shift; add_ssh "$@" ;;
  doctor) doctor ;;
  espanso)
    case "${2:-status}" in
      on) shift 2; espanso_on "$@" ;;
      off) espanso_off ;;
      status) espanso_status ;;
      *) die "omakvm espanso on|off|status" ;;
    esac ;;
  root-setup) shift; root_setup "$@" ;;
  root-espanso) root_espanso ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $1 (try: omakvm --help)" ;;
esac
